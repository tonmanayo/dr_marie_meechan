# MailerLite newsletter integration (server-side only)
# Get a token: MailerLite → Integrations → API → generate.
MAILERLITE_API_TOKEN=
# The target group's ID (e.g. "Letters from Marie").
MAILERLITE_GROUP_ID=

# Sanity — public (safe to expose; set in .env.local and in Netlify)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Sanity — secret (Netlify + local only — NEVER commit)
SANITY_REVALIDATE_SECRET=
# Local only, migration script (NEVER commit, not needed in Netlify)
SANITY_WRITE_TOKEN=
